# MINI RT — CLASSICAL OPEN COLONNADE / DECOR ONLY
# Scene d'allée ouverte : pas de mur du fond, pas d'objets miroir.
# Fourni avec texture/marble_ivory.xpm et texture/meadow_grass.xpm.
R 1500 1100

C 0,17.5,30 0,-0.045,-0.998987 70


# Lumiere ambiante faible
A 0.06 255,245,230

# Soleil d'ete — exterieur, haut et legerement a gauche
L -85,190,-310 0.95 255,240,210

# Eclairage interieur discret et chaud
l 0,32,-45 0.14 255,235,215

# Leger remplissage au fond de la galerie
l 5,32,-125 0.10 225,235,255

# Prairie jusqu'a l'horizon, visible derriere et de chaque cote.
pl 0,-0.70,0 0,1,0 81,129,70 texture=texture/grass.xpm uv=0.12,0,0,0.12,0,0 ambient=0.12 diffuse=0.88 specular=0
skybox texture/blue_clouds_sky.xpm sp 1,1,1 uv=16.686,0,0,9.309,-3.671,-4.276

# =========================================================
# MURS EN PIERRE — GALERIE V1
# 3 murs, 6 triangles — ouverture vers le fond de l'image
# =========================================================
# =========================================================
# MAT — MURS
# =========================================================
mat texture=texture/marble_ivory_seamless.xpm ambient=0.10 diffuse=0.82 specular=0.02 shininess=8 bump=texture/organic_soft_bump.xpm bscale=1.2
# MUR GAUCHE
tr -31,0,60 -31,0,-172 -31,43,-172 210,204,194 texture=texture/marble_ivory_seamless.xpm
tr -31,0,60 -31,43,-172 -31,43,60 210,204,194 texture=texture/marble_ivory_seamless.xpm

# MUR DROIT
tr 31,0,60 31,43,-172 31,0,-172 210,204,194 texture=texture/marble_ivory_seamless.xpm
tr 31,0,60 31,43,60 31,43,-172 210,204,194 texture=texture/marble_ivory_seamless.xpm

# MUR ARRIERE — prolongé au-dessus de la voûte
tr -31,0,33 31,65,33 31,0,33 210,204,194 texture=texture/marble_ivory_seamless.xpm
tr -31,0,33 -31,65,33 31,65,33 210,204,194 texture=texture/marble_ivory_seamless.xpm

# =========================================================
# MAT — OBJET DECORATIF
# Un peu plus present que les murs, mais pas miroir
# =========================================================
mat texture=texture/marble_ivory_seamless.xpm ambient=0.07 diffuse=0.85 specular=0.12 shininess=52 bump=texture/organic_soft_bump.xpm bscale=10.0

# =========================================================
# POTEAU DECORATIF
# Position : centre de l'allee
# =========================================================

# fut principal
cy 0,0,-58 0,1,0 1.90 12.00 214,206,194

# fermeture / tete principale
sp 0,12.00,-58 1.90 222,214,202

# petit raccord central
cy 0,13.10,-58 0,1,0 0.58 1.55 208,200,188

# sphere superieure
sp 0,14.85,-58 1.45 226,218,206


mat
# DALLES : galerie limitee en largeur ; pas de plan infini qui cache la prairie.
tr -31.000,0.080,42.000 -23.250,0.080,42.000 -23.250,0.080,32.273 215,211,202 ambient=0.09 diffuse=0.89 specular=0.10 shininess=38
