#resolution
R  1600 1200
# Ambient
A 0.02 255,255,255

# Camera : position (0, 2, 12) regardant vers l'origine

C 1.886,3.491,26.819  -0.070615,-0.018325,-0.997335 60
c 0,3,21  0,0,-1  60
c 0,3,21  0,0,-1  45

#sphere jsute devant la cam distance - R dans le plan focal image
to 0,3,20.5 0,1,0 1 0.5 255,255,255  diffuse=0 specular=0 shininess=0 refraction=1 reflection=1 ior=1.15 bump=texture/lunar_bump.xpm bscale=0

# Lumière blanche au-dessus à droite
L 3,6,3  0.9  255,255,255
# Sol gris
pl 0,0,0  0,1,0  120,120,120 texture=texture/pavage.xpm checkerboard=texture/ground.xpm  uv=0.7,0,0,0.7,0,0


skybox texture/puresky.xpm sp 0.5,0.5,0.5

###############################
#   BANDE TEST SPECULAIRE     #
###############################

# 1. Mat total (ks = 0)
#sp -5,3,0  7  200,50,50  diffuse=1  specular=0.15 shininess=32 texture=terre.xpm uv=-1,0,0,-1,0.7,0

l -5,3,0  0.3  255,255,255

# 2. Plastique mat (ks = 0.2)
sp -3,1,0  1  200,200,50  diffuse=1  specular=0.1  shininess=10

# 3. Plastique brillant (ks = 0.4)
sp -1,1,0  1  50,200,50  diffuse=1  specular=0.4  shininess=32

# 4. Vernis / laqué (ks = 0.6)
sp 1,1,0  1  50,200,200  diffuse=1  specular=0.6  shininess=64

# 5. Acier poli (ks = 0.8)
sp 3,1,0  1  50,50,200  diffuse=1  specular=0.8  shininess=128

# 6. Chrome (ks = 1.0)
sp 5,1,0  1  200,200,200  diffuse=1  specular=1.0  shininess=256

#7. try mat with high shininess
sp 2,3,0  1  150,100,50  diffuse=1  specular=0.9  shininess=512

#8. try shiny with low shininess
sp -2,3,0  1  50,100,150  diffuse=1  specular=0.3  shininess=8

#9 try de la reflexion un couleur tres metal
sp 0,3,0 1 80,80,80 diffuse=0.2 specular=0.8 shininess=200 reflection=0.5

#10 try de la reflexion un couleur tres metal
sp 4,3,0 1 150,150,150 diffuse=0.2 specular=0.8 shininess=300 reflection=0.7

#11 un full mirroir
sp 1,4.5,0 1 255,255,255 diffuse=0 specular=0 shininess=0 reflection=1

#une goute deau au prmeeir plan
sp 0,1,10 2 0,255,255 ior=1.5 diffuse=1 specular=0.5 shininess=100  reflection=0.1 refraction=0.9

#cylindre metalise
cy 5,0,1 0,1,0  2 2  255,100,100 ambient=0.5 diffuse=0.3 specular=0.3 shininess=300 reflection=0.3 refraction=0.000

# deuxieme cylyndre en longueur
cy 0,0,-5 1,0,0  1 6  100,100,255 ambient=0.1 diffuse=0.1 specular=0.2 shininess=100 reflection=1 refraction=0.001

#to -5,5,5  0,1,1  2 1  0,255,0 texture=texture/terre.xpm 

to -5,3,0  1,1,1  2 1  0,255,0 texture=texture/2k_earth_daymap.xpm uv=1,0,0,1,0,0.5

###############################
#   ANNEAUX JO – DAMIER       #
###############################

# Ligne du haut
to -4,6,-18  0,0,1  3.2 0.45  0,112,192   checkerboard=0,80,150    uv=100,0,0,10,0,0  diffuse=1 specular=0.3 shininess=64   # Bleu
to  0,6,-18  0,0,1  3.2 0.45  0,0,0       checkerboard=40,40,40    uv=100,0,0,10,0,0  diffuse=1 specular=0.3 shininess=64   # Noir
to  4,6,-18  0,0,1  3.2 0.45  221,0,49    checkerboard=170,0,40   uv=100,0,0,10,0,0  diffuse=1 specular=0.3 shininess=64   # Rouge

# Ligne du bas
to -2,4.2,-18  0,0,1  3.2 0.45  255,184,28 checkerboard=210,150,20 uv=100,0,0,10,0,0  diffuse=1 specular=0.3 shininess=64   # Jaune
to  2,4.2,-18  0,0,1  3.2 0.45  0,166,81   checkerboard=0,120,60   uv=100,0,0,10,0,0  diffuse=1 specular=0.3 shininess=64   # Vert


