#deuxieme tore avec dautee couleur 
to  10,-3,0  1,0,0  15 5  0,0,255 checkerboard=0,0,150  uv=30,0,0,10,0,0 refraction=0.9 ior=1.01

#petite sphere 
sp 7,1,2 2 255,255,0 diffuse=1 specular=0.5 shininess=100 checkerboard=150,150,0 uv=60,-30,15,-30,0,0

sp 5,1,6  1  255,100,100 ambient=0.5 diffuse=0.3 specular=0.3 shininess=300 reflection=0.3 refraction=0.000