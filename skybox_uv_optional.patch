+	old_u = *u;
+	old_v = *v;
+	*u = scene->skybox.uv[0] * old_u + scene->skybox.uv[1] * old_v
+		+ scene->skybox.uv[4];
+	*v = scene->skybox.uv[2] * old_u + scene->skybox.uv[3] * old_v
+		+ scene->skybox.uv[5];
+}
 
